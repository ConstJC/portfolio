# EmailJS — Contact Form (Cta.tsx)
# Get these from https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_ENABLED=true
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Chat Widget — Google Gemini free tier (app/api/chat/route.ts)
# Server-only: never prefix these with NEXT_PUBLIC_.
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Check your actual free-tier RPD at https://aistudio.google.com/rate-limit
# and set this comfortably below it — the API doesn't publish a fixed number.
DAILY_REQUEST_LIMIT=200
